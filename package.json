{
  "name": "@oktomusic/monorepo",
  "version": "0.0.0",
  "private": true,
  "keywords": [],
  "type": "module",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "commitlint": "commitlint --edit",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "build": "pnpm run --filter \"*\" build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:cov": "vitest run --coverage",
    "test:backend": "vitest run --project=@oktomusic/backend",
    "test:backend:watch": "vitest --project=@oktomusic/backend",
    "test:backend:cov": "vitest run --project=@oktomusic/backend --coverage",
    "test:backend:e2e": "vitest run --project=@oktomusic/backend:e2e",
    "test:frontend": "vitest run --project=@oktomusic/frontend",
    "test:frontend:watch": "vitest --project=@oktomusic/frontend",
    "test:frontend:cov": "vitest run --project=@oktomusic/frontend --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@e18e/eslint-plugin": "^0.8.1",
    "@oxc-node/core": "^0.1.7",
    "@types/node": "catalog:default",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint-plugin-lingui": "^0.16.0",
    "graphql-config": "^5.1.8",
    "husky": "^9.1.7",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "catalog:default",
    "vitest": "^5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "^24",
      "onFail": "error"
    }
  }
}
