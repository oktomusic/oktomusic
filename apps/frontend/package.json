{
  "name": "@oktomusic/frontend",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "pnpm -w exec eslint --flag unstable_native_nodejs_ts_config -c eslint.config.ts apps/frontend",
    "lint:fix": "pnpm -w exec eslint --flag unstable_native_nodejs_ts_config -c eslint.config.ts --fix apps/frontend",
    "po:extract": "lingui extract",
    "po:extract:watch": "lingui extract --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "codegen": "graphql-codegen --config codegen.ts",
    "pwa-assets": "pwa-assets-generator"
  },
  "dependencies": {
    "@apollo/client": "^4.3.3",
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/react": "^0.5.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@oktomusic/api-schemas": "workspace:^",
    "@tailwindcss/vite": "^4.3.3",
    "graphql": "^17.0.2",
    "graphql-ws": "6.3.0",
    "jotai": "^3.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-router": "^8.4.0",
    "tailwindcss": "^4.3.3",
    "temporal-polyfill": "catalog:default"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/client-preset": "6.2.3",
    "@lingui/cli": "^6.9.1",
    "@lingui/core": "^6.9.1",
    "@lingui/react": "^6.9.1",
    "@lingui/vite-plugin": "^6.9.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/node": "catalog:default",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/devtools": "^0.7.6",
    "@vitejs/devtools-oxc": "^0.7.6",
    "@vitejs/devtools-rolldown": "^0.7.6",
    "@vitejs/devtools-vite": "^0.7.6",
    "@vitejs/devtools-vitest": "^0.7.6",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.4",
    "globals": "^17.13.0",
    "jotai-devtools": "^0.15.1",
    "jotai-rolldown": "^0.2.0",
    "jsdom": "^30.1.2",
    "lightningcss": "^1.33.0",
    "oxc-transform-react": "^0.153.0",
    "typescript": "catalog:default",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-sri-gen": "^1.7.4",
    "vitest": "^5.0.4",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-range-requests": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
